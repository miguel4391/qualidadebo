                                }else{
                                    $('#tbDataGrauEstrang').val('');
                                    $('#tbnotaEstrang').val('');
                                    $('#plnGrauEstrang').addClass("invisible");
                                }
                            }
                        </script>
                    </div>
                </div>
                <div class="row mt-5 invisible" id="plnGrauEstrang">
                    <div class="form-check form-check-inline">
                        <input type="radio" class="btn-check" name="optionsGrau" id="grauNivel" value="nivel" autocomplete="off" <%= ficha[0].grauNivelDoc == "nivel" ? "checked" : "" %>>
                        <label class="btn " for="grauNivel">Reconhecimento de nível</label>
                        <input type="radio" class="btn-check" name="optionsGrau" id="grauEspecific" value="especifico" autocomplete="off" <%= ficha[0].grauNivelDoc == "especifico" ? "checked" : "" %>>
                        <label class="btn " for="grauEspecific">Reconhecimento específico</label>
