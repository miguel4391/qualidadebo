                        <span class="input-group-text" id="notaEstrangAddon">Equivalência do Grau e Conversão de Nota:</span>
                        <input type="text" class="form-control" id="tbnotaEstrang" name="tbnotaEstrang" aria-label="tbnotaEstrang" aria-describedby="notaEstrangAddon" value="<%= ficha[0].equivGraduEst %>">
                    </div>
                </div>
                <div class="row mt-5 ">
