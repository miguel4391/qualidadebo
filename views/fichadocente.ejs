                        <select class="form-select" aria-label="Selecionar uma opção" id="cbAreaDocente2Esp" name="cbAreaDocente2Esp">
                            <option selected>Selecionar uma opção</option>
                        </select>
                    </div>
                    <div class="row mt-3">
                        <div class="input-group mb-3">
                            <span class="input-group-text" id="anoEspAddon">Ano em que foi obtido este título de especialista</span>
                            <input type="text" class="form-control" inputmode="numeric" pattern="[0-9]+" id="tbAnoEsp" name="tbAnoEsp" aria-label="tbAnoEsp" aria-describedby="anoEspAddon" value="<%= ficha[0].anoTitEspec %>">
                        </div>
                        <script>
                            $('#tbAnoEsp').on('input', function () {
                                this.value = this.value.replace(/[^0-9]/g, '');
                            });
                        </script>
                        <div class="input-group mb-3">
                            <span class="input-group-text" id="iesEspAddon">Instituição que conferiu este título de especialista</span>
                            <input type="text" class="form-control" id="tbIesEsp" name="tbIesEsp" aria-label="tbIesEsp" aria-describedby="iesEspAddon" value="<%= ficha[0].iesTitEspec %>">
                        </div>
                        <div class="input-group mb-3">
                            <span class="input-group-text" id="iesEspEstAddon">Instituição que conferiu este título de especialista (Inglês)</span>
                            <input type="text" class="form-control" id="tbIesEspEst" name="tbIesEspEst" aria-label="tbIesEspEst" aria-describedby="iesEspEstAddon" value="<%= ficha[0].iesTitEspecEng %>">
                        </div>
                    </div>
                </div> 
                <div class="row mt-5">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="perDedicAddon">Regime de dedicação na instituição (%)</span>
                        <input type="text" class="form-control" inputmode="numeric" pattern="[0-9]+" id="tbPercDedic" name="tbPercDedic" aria-label="tbPercDedic" aria-describedby="perDedicAddon" value="<%= ficha[0].percIes %>">
                    </div>
                    <script>
                        $('#tbPercDedic').on('input', function () {
                            this.value = this.value.replace(/[^0-9]/g, '');
                            let value = parseInt(this.value, 10);

                            if (!isNaN(value)) {
                                if (value > 100) value = 100;
                                if (value < 0) value = 0;

                                this.value = value;
                            }
                        });
                    </script>
                </div> 
                <div class="row mt-5">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="cienciaVitaeAddon">Código Ciência Vitae</span>
