                        <input type="text" class="form-control startdate" id="tbDataGrauEstrang" name="tbDataGrauEstrang" aria-label="tbDataGrauEstrang" aria-describedby="dataGrauEstragAddon" value="<%= ficha[0].dataRegEst %>">
                    </div>
                    <script>
                        $(function() {
                            $('#tbDataGrauEstrang').datepicker();
                        });
                        
                    </script>
