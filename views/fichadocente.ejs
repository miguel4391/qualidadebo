                            <div class="form-check">
                                <input 
                                    class="form-check-input area-checkbox" 
                                    type="checkbox" 
                                    value="<%= orgao.codOpcao %>"                                    
                                    name="areas[]"
                                    checked
                                    disabled
                                >
                                <label class="form-check-label"><%= orgao.opcao %></label>
                            </div>
                        <% }else{ %>
                        <div class="form-check">
                                <input 
                                    class="form-check-input area-checkbox" 
                                    type="checkbox" 
                                    value="<%= orgao.codOpcao %>"                                    
                                    name="areas[]"
                                >
                                <label class="form-check-label"><%= orgao.opcao %></label>
                            </div>
                        <% } %>
                    <% }) %>
                </div>
                <div class="row mt-5">
                    <div class="form-check">
                        <input type="checkbox" id="doutorando" name="doutorando" class="form-check-input" <%= ficha[0].doutorando == 1 ? "checked" : "" %>  >
