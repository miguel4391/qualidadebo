                        </label>
                    </div>
                </div>
                <div class="row mt-5 invisible" id="plnDoutorando">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="anoDoutorandoAddon">Ano da primeira inscrição</span>
                        <input type="text" class="form-control" id="tbAnoDoutorando" name="tbAnoDoutorando" aria-label="tbAnoDoutorando" aria-describedby="anoDoutorandoAddon" value="<%= ficha[0].anoDoutorando %>">
                    </div>
                    
                    <script>
                        $('#tbAnoDoutorando').on('input', function () {
                            this.value = this.value.replace(/[^0-9]/g, '');
                        });
                    </script>
                </div>
                <div class="row mt-5">
                    <div class="form-check">
                        <input type="checkbox" id="autoriza" name="autoriza" class="form-check-input" <%= ficha[0].auth == 1 ? "checked" : "" %>>
                        <label class="form-check-label fs-7" for="autoriza">
                            Autoriza que as suas informações pessoais sejam recolhidas, armazenadas e utilizadas pelas entidades, EIA — Ensino, Investigação e Administração, S.A. e A3ES - Agência de Avaliação e Acreditação do Ensino Superior, exclusivamente para fins funcionais e analíticos, no âmbito dos processos de acreditação.
                        </label>
                    </div>
                </div>
                <div class="row mt-5">
                    <div class="col">
                        <div class="d-grid gap-2">
                            <a href="https://qualidadebo.uatlantica.pt/fichaDocente" class="btn btn-danger">Voltar</a>
                        </div>
                    </div>
                    <div class="col">
                        <div class="d-grid gap-2">
                            <button class="btn btn-sm btn-outline-primary">Gravar</button>
                        </div>
                    </div>
                    
                </div>
            </form>
            

