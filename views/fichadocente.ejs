                        <input type="checkbox" id="tituloEsp" name="tituloEsp" class="form-check-input" onchange="tituloEspChng()" <%= ficha[0].especialDoc == 1 ? "checked" : "" %>>
                        <label class="form-check-label" for="tituloEsp">
                            Título de Especialista
                        </label>
                        <script>
                            function tituloEspChng(){
                                if($("#tituloEsp").is(":checked")){
                                    
                                    $('#plnTituloEsp').removeClass("invisible");
                                }else{
                                    //$('#tbDataGrauEstrang').val('');
                                    //$('#tbnotaEstrang').val('');
                                    $('#plnTituloEsp').addClass("invisible");
                                }
                            }
                        </script>
                    </div>
                </div>
                <div class="row mt-5 invisible" id="plnTituloEsp">
