<%- include('partials/header') %>
<style>
	.card:hover{
		box-shadow: inset 0 0 1em grey, 0 0 1em black;
	}
</style>

<div class="container-fluid mt-5">
	<div class="row">
		<div class="col-xl-2 col-lg-1">
			<%- include('partials/sideMenu') %>
		</div>
		<div class="col-xl-8">
			<div class="container border ">
				<div class="row m-5">
					
					<form action="upload" method="post">
						<div class="row mb-3">
							<input type="hidden" name="essatla" id="essatla" value="1">	
							<input type="hidden" name="atlan" id="atlan" value="0">	
							<h1>Importação de Ficheiros ESSATLA</h1>  
						</div>
						<div class="row mb-3">
			
							<div class="col-xl-6 col-md-12">
								<label for="fileType" class="form-label">Escolha o tipo de ficheiro</label>
								<select class="form-select" aria-label="Select File type" id="fileType" name="fileType">
									<option selected>----------------------</option>
											<% tipos.forEach((tipo) => {%>
										<option value="<%= tipo.tipo_nome %>"><%= tipo.tipo_nome %></option>
									<%})%>
								  </select>
								  <script>
									$("#fileType").on("change", function() {
										if ($(this).val() == 'Planos de Estudo') {
											$("#cursoSelect").show();
										} else {
											$("#cursoSelect").hide();
										}
									});
								  </script>
							</div>
							<div class="col-xl-6 col-md-12">
								<label for="fileName" class="form-label">Escolha o nome do ficheiro</label>
								<input class="form-control" type="text" placeholder="Nome ficheiro" aria-label="Input file name" id="fileName" name="fileName">
							</div>
						</div>
						<div class="mb-3 row">
							<div class="col-xl-6 col-md-12">
								<label for="codFile" class="form-label">Coloque o código do ficheiro</label>
								<input class="form-control" type="text" placeholder="Código do Ficheiro" aria-label="Input file code" id="codFile" name="codFile">
							</div>
							<div class="col-xl-6 col-md-12">
								<label for="fileDepartment" class="form-label">Escolha o departamento</label>
								<select class="form-select" aria-label="Select File Department" id="fileDepartment" name="fileDepartment">
									<option selected>----------------------</option>
									<% depart.forEach((dep) => {%>
										<option value="<%= dep.depart_nome %>"><%= dep.depart_nome %></option>
									<% })%>
								</select>
							</div>
						</div>
						<div class="mb-3 row">
							<div class="col-xl-6 col-md-12">
								<label for="formFile" class="form-label">Selecione o ficheiro a importar</label>
								<input class="form-control" type="file" id="formFile" name="formFile">	
							</div>

							<div id="cursoSelect" class="col-xl-6 col-md-12" style="display: none;">
								<label for="formCurso" class="form-label">Selecione o curso</label>
								<select class="form-select" aria-label="Select Curso" id="formCurso" name="formCurso">
									<option selected>----------------------</option>
									<% curso.forEach((ce) => { %>
										<option value="<%= ce.sigla %>"><%= ce.sigla %></option>
									<% }) %>
								</select>
							</div>
						</div>
						<button id="submitBtn" class="btn btn-outline-primary btn-sm" type="submit">Enviar</button>		
					</form>
			
				</div>
				
			</div>
		</div>
		<div class="col-2"></div>
	</div>	
</div>



<%- include('partials/footer') %>
