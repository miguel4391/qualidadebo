<%- include('partials/header') %>
    <div class="container mt-5"> 
        <div class="row">
            <h2><%= curso[0].Curso %></h2>
        </div>
        <form action="/setRegentes/<%= curso[0].idCurso %>" method="post">
            <div class="row g-3 align-items-center mt-3">
                <div class="col-auto">
                    <label class="form-sm form-label" for="tbNomeCoord"><strong>Coordenador do Ciclo de Estudos</strong></label>
                </div>
                <div class="col-6">
                    <input type="text" id="tbNomeCoord" name="tbNomeCoord" class="form-control form-sm" value="<%= curso[0].NomeCoord %>">
                </div>
            </div>
            <div class="row g-3 align-items-center mt-3">
                <div class="col-auto">
                    <label class="form-sm form-label" for="tbCoordCurso"><strong>Login(s)</strong></label>
                </div>
                <div class="col-6">
                    <input type="text" id="tbCoordCurso" name="tbCoordCurso" class="form-control form-sm" value="<%= curso[0].Login %>">
                </div>
            </div>
            <div class="row mt-5">
                <table class="table table-striped table-sm table-hover" id="tableCE" name="tableCE">
                    <thead class="table-dark">
                        <tr>
                            <th></th>
                            <th>Unidade Curricular</th>
                            <th>Responsável de UC</th>
                            <th>Login</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% docentes.forEach((docente) =>{ %>
                            <tr>
                                <td><%= docente.IdFuc %></td>
                                <td><%= docente.UC %></td>
                                <td><input type="text" id="<%= docente.IdFuc %>" name="<%= docente.IdFuc %>" value="<%= docente.Nome %>" /></td>
                                <td><input type="text" id="<%= docente.IdFuc %>" name="<%= docente.IdFuc %>" value="<%= docente.Login %>" /></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            <div class="row">
                <div class="col-5"><div class="d-grid gap-2"><a href="/regentes" class="btn btn-secondary btn-sm">Voltar</a></div></div>
                <div class="col-7"><div class="d-grid gap-2"><button type="submit" class="btn btn-primary btn-sm">Gravar</button></div></div>
            </div>
        </form>
    </div>
<%- include('partials/footer') %>